.idea/
*.iml
*.iws
*.ipr
out/

# IDE - Other
*.swp
*.swo
*~
.project
.classpath
.settings/
.loadpath
.externalToolBuilders/
*.launch
.cproject

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
